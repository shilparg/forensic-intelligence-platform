# 🕵️‍♂️ Forensic Intelligence Platform: Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.

# ==============================================================================
# 1. GOOGLE CLOUD PLATFORM (GCP)
# ==============================================================================
# Your GCP Project ID where BigQuery is enabled.
GCP_PROJECT_ID=your-project-id

# Path to your GCP Service Account JSON key file (relative to project root).
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json

# ==============================================================================
# 2. EXTERNAL DATABASES & APIs
# ==============================================================================
# MongoDB Atlas Connection String (for SEC text storage).
MONGO_URI=your-mongodb-atlas-connection-string

# Google Gemini API Key (for Executive Memo generation).
GEMINI_API_KEY=your-gemini-api-key

# SEC EDGAR User Agent (Required: Name + Email).
SEC_USER_AGENT=ForensicBot (your-email@example.com)

# ==============================================================================
# 3. BIGQUERY MEDALLION LAYER CONFIGURATION (OPTIONAL CUSTOMIZATION)
# ==============================================================================
# These variables control where data is stored in BigQuery.
# Default values are shown below. Change them ONLY if you need a custom schema.

# Silver Layer: Cleaned and structured landing zone.
# BQ_RAW_DATASET=raw_sec_landing

# Gold Layer: Final analytics and AI-scored data.
# BQ_FINAL_DATASET=forensic_data

# Table names for the ingestion engines.
# BQ_RAW_FILINGS_TABLE=raw_sec_filings
# BQ_RAW_FINANCIALS_TABLE=raw_financials
