  create or replace view `forensic-accounting-bot`.`forensic_data`.`stg_sec_filings`
  OPTIONS()
  as -- models/staging/stg_sec_filings.sql


WITH raw_data AS (
    -- This references the source we will define in your schema.yml
    SELECT * FROM `forensic-accounting-bot`.`raw_sec_landing`.`raw_sec_filings`
)

SELECT
    -- 1. Standardized Identifiers
    UPPER(CAST(ticker AS STRING)) AS ticker,
    CAST(fiscal_year AS INT64) AS fiscal_year,
    
    -- 2. Cleaned Forensic Metrics
    COALESCE(CAST(sentiment_score AS FLOAT64), 0.0) AS sentiment_score,
    COALESCE(CAST(similarity_index AS FLOAT64), 0.0) AS similarity_index,
    
    -- 3. Text for Disclosure Density & Obfuscation Analysis
    TRIM(parsed_text_sample) AS filing_text,
    
    -- 4. Audit Metadata
    CURRENT_TIMESTAMP() AS processed_at
FROM raw_data
-- Safety check: ensure we don't process empty rows
WHERE ticker IS NOT NULL
-- Deduplicate multiple runs of the same API data
QUALIFY ROW_NUMBER() OVER(PARTITION BY ticker, fiscal_year ORDER BY ticker) = 1;


[0m17:16:16.802968 [debug] [Thread-1 (]: On model.forensic_transform.stg_financials: /* {"app": "dbt", "dbt_version": "1.8.8", "profile_name": "forensic_profile", "target_name": "dev", "node_id": "model.forensic_transform.stg_financials"} */


  create or replace view `forensic-accounting-bot`.`forensic_data`.`stg_financials`
  OPTIONS()
  as 

WITH raw_financials AS (
    SELECT * FROM `forensic-accounting-bot`.`raw_sec_landing`.`raw_financials`
)

SELECT
    UPPER(CAST(ticker AS STRING)) AS ticker,
    CAST(short_ratio AS FLOAT64) AS short_ratio,
    CAST(debt_to_equity AS FLOAT64) AS debt_to_equity,
    CAST(return_on_equity AS FLOAT64) AS return_on_equity,
    CAST(operating_margin AS FLOAT64) AS operating_margin,
    CAST(held_institutions AS FLOAT64) AS held_institutions,
    CAST(insider_ownership AS FLOAT64) AS insider_ownership,
    CAST(current_ratio AS FLOAT64) AS current_ratio,
    CAST(quick_ratio AS FLOAT64) AS quick_ratio,
    CAST(revenue_growth AS FLOAT64) AS revenue_growth,
    CAST(earnings_growth AS FLOAT64) AS earnings_growth,
    CAST(profit_margins AS FLOAT64) AS profit_margins,
    CAST(free_cashflow AS FLOAT64) AS free_cashflow
FROM raw_financials
WHERE ticker IS NOT NULL;


