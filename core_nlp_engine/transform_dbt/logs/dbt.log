  create or replace view `forensic-accounting-bot`.`forensic_data`.`rpt_boilerplate_offenders`
  OPTIONS()
  as 

SELECT 
    ticker, 
    COUNT(fiscal_year) as consecutive_boilerplate_years,
    ROUND(AVG(similarity_index), 4) as avg_similarity
