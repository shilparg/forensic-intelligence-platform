        -- 1. Disclosure Density (Word count vs Sentiment)
        SAFE_DIVIDE(ARRAY_LENGTH(SPLIT(filing_text, ' ')), ABS(sentiment_score)) AS density_index,
        
        -- 2. Sentiment Volatility (Looking at standard deviation for the ticker)
